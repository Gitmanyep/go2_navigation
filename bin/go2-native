#!/usr/bin/env bash
set -euo pipefail
GO2_NATIVE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
GO2_NATIVE_PYTHON="$GO2_NATIVE_ROOT/.venv/bin/python3"
if [[ ! -x "$GO2_NATIVE_PYTHON" ]]; then GO2_NATIVE_PYTHON=/usr/bin/python3; fi
exec "$GO2_NATIVE_PYTHON" -u "$GO2_NATIVE_ROOT/native/runner.py" "$@"
