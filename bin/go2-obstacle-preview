#!/usr/bin/env bash
set -euo pipefail
GO2_OBSTACLE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
GO2_OBSTACLE_PYTHON="$GO2_OBSTACLE_ROOT/.venv/bin/python3"
if [[ ! -x "$GO2_OBSTACLE_PYTHON" ]]; then GO2_OBSTACLE_PYTHON=/usr/bin/python3; fi
exec "$GO2_OBSTACLE_PYTHON" -u "$GO2_OBSTACLE_ROOT/native/obstacle_runner.py" "$@"
