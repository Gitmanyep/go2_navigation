Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 25; 25; 25
    Frame Rate: 5
  Displays:
    - Class: rviz/Grid
      Name: Reference
      Enabled: true
      Cell Size: 1
    - Class: rviz/Marker
      Name: Native data status
      Enabled: true
      Marker Topic: /go2/native/status_text
    - Class: rviz/PointCloud2
      Name: Native raw cloud
      Enabled: true
      Topic: /go2/native/cloud
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/PointCloud2
      Name: Native deskewed cloud
      Enabled: false
      Topic: /go2/native/cloud_deskewed
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/PointCloud2
      Name: Native SLAM map
      Enabled: true
      Topic: /go2/native/slam_cloud
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/PointCloud2
      Name: Native height map
      Enabled: false
      Topic: /go2/native/height_cloud
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/Pose
      Name: Native robot pose
      Enabled: true
      Topic: /go2/native/pose
      Shape: Axes
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 760
